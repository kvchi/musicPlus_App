# Clerk publishable key used by the browser application.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_example_only

# Last.fm API key used for metadata requests.
VITE_LASTFM_API_KEY=example_lastfm_api_key

# Last.fm API base URL.
VITE_BASE_URL=https://example.invalid/lastfm

# Jamendo API base URL used for music requests.
VITE_JAMENDO_API_URL=https://example.invalid/jamendo

# Jamendo public client identifier.
VITE_JAMENDO_CLIENT_ID=example_jamendo_client_id
