# Local port for the Express health server.
PORT=4000

# Restricted music-application MongoDB connection string.
DATABASE_URL=mongodb+srv://example_user:example_password@example.invalid/music

# Server-only Clerk keys for verified playlist API requests. Never use a VITE_ prefix for the secret.
CLERK_PUBLISHABLE_KEY=pk_test_example_only
CLERK_SECRET_KEY=sk_test_example_only

# Exact frontend origins allowed to issue Clerk session tokens. Set your HTTPS origin in production.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173
